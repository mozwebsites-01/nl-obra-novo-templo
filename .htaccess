# Configuração Apache (DirectAdmin) para a app NL Obra

# O manifesto da app instalável precisa deste tipo
AddType application/manifest+json .webmanifest

DirectoryIndex index.html

# A app só pode ser instalada no telemóvel em HTTPS: redireciona HTTP → HTTPS
# (ative o certificado Let's Encrypt no DirectAdmin antes de ser publicado)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # O service worker e o HTML não ficam em cache: as atualizações chegam logo
  <FilesMatch "^(sw\.js|index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Estilos e código: o navegador confirma sempre se há versão nova (sem esperar 7 dias)
  <FilesMatch "\.(css|js|mjs)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Imagens e ícones podem ficar em cache uma semana
  <FilesMatch "\.(png|jpg|jpeg|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Segurança máxima no navegador:
  #  - só o código deste site corre; só o servidor da obra (Supabase) pode ser contactado
  #  - o site não pode ser metido dentro de outra página (proteção contra cliques enganadores)
  #  - HTTPS obrigatório durante 2 anos; câmara, microfone e localização desligados
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://obqoavamffnobtpggwfb.supabase.co wss://obqoavamffnobtpggwfb.supabase.co; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

# Nunca servir ficheiros internos (código do servidor, scripts, configuração do git)
<IfModule mod_rewrite.c>
  RewriteRule (^|/)\.(?!well-known) - [F,L]
  RewriteRule ^(supabase|scripts)(/|$) - [F,L]
</IfModule>
Options -Indexes
